# problem-specific runtime parameters
#
# CR_Streaming_Test : test problems (Jiang & Oh 2018, Sec 4)
#    0 = 1D triangular Ec profile         (Sec 4.1.1, Fig. 3)
#    1 = 1D Gaussian Ec profile           (Sec 4.1.1 streaming / 4.1.4 diffusion)
#    2 = 2D Gaussian Ec, diagonal B       (Sec 4.1.2 streaming / 4.1.5 anisotropic diffusion)
#    3 = 2D ring Ec, circular B           (Sec 4.1.5)
#    4 = 1D density cloud (bottleneck)    (Sec 4.1.3: CRs injected from -x into a cold cloud)
#    5 = 1D CR-driven wave                (Sec 4.2.1: full MHD+CR coupling)
#    6 = 2D CR-driven blast wave          (Sec 4.2.3: diffusion or streaming case via CR_STREAM)
#    7 = classic CR_Diffusion port        (Gaussian, uniform B||x; compares CR_E vs CRay)
#    8 = classic CR_ShockTube port        (CR locked to gas via CR_SIGMA/CR_STREAM=0, CR_SOURCE=1)
#    9 = classic CR_SoundWave port        (CR-modified acoustic wave, CR locked to gas as in 8)
#   10 = colliding-flow CR-modified shock (Sec 4.2.2, Fig. 11); set CR_Streaming_Ec0 per run
#   11 = 3D CR-driven blast wave          (3D generalization of Test 6)

CR_Streaming_Test          0              # test problem (see above) [0]
CR_Streaming_Dir           0              # streaming/wave axis for the 1D tests (0/1/2 = x/y/z; 3 = (1,1,1) for Test 9 only) [0]
CR_Streaming_FlowV         0.0            # uniform flow velocity along CR_Streaming_Dir; inflow speed for Test 10 [0.0]
CR_Streaming_GradOutflowBC 0              # gradient-preserving CR outflow BC on the x faces (Fig. 3; resets OPT__BC_FLU_XM/XP to 4) [0]
CR_Streaming_Ec0           1.0            # uniform CR energy density for Test 10 (paper: 1, 50, or 200) [1.0]
CR_Streaming_FcInit        1              # Test 10 initial CR flux: 1=advective (4/3)v*Ec (paper), 0=zero [1]
CR_Streaming_B_theta       90.0           # Test 11 only: polar angle of B in degrees (from +z axis) [90.0]
CR_Streaming_B_phi         0.0            # Test 11 only: azimuthal angle of B in degrees (from +x axis) [0.0]
